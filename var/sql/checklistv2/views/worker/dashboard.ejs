<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff PWA Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
  <link rel="stylesheet" href="/css/pwa-style.css">
  <link rel="stylesheet" href="/css/bs-addons.css">
  <style>
    #dashboardTabs.nav {
      /* flex-wrap: nowrap; */
      /* white-space: nowrap; */
      /* overflow: auto; */
    }

    #dashboardTabs::-webkit-scrollbar,
    div.tab-content::-webkit-scrollbar {
      display: none;
    }
  </style>
</head>
<body x-data="workerDashboard" x-init="start">
  <%- include('./_partials/navbar-top') %>
  <template x-if="appLoading">
    <div style="z-index: 2000;"
      class="position-fixed top-0 start-0 d-flex align-items-center justify-content-center vh-100 vw-100 bg-light opacity-75">
      <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
    </div>
  </template>
  <template x-if="!initialFetching">
    <main class="container mt-3 mb-5">
      <h2 class="text-muted fs-4 mb-4">Welcome, <%= authUser.name %></h2>

      <div class="nav nav-underline nav-justified" id="dashboardTabs" role="tablist" style="font-size: .7rem;">
        <button class="text-primary nav-link active" id="inprogress-tab" data-bs-toggle="tab" data-bs-target="#inprogress" type="button" role="tab">Inprogress</button>
        <button class="text-primary nav-link" id="complete-tab" data-bs-toggle="tab" data-bs-target="#complete" type="button" role="tab">Completed Tasks</button>
      </div>




      <div style="min-height: 60lvh;">
        <div class="tab-content mt-3" id="dashboardTabsContent">

                  <div class="tab-pane active show fade" id="inprogress" role="tabpanel">
                    <h5 class="mb-2 mt-4">Projects</h5>
                    <div id="projectAccordion" class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-2 align-items-start">
                        <template x-for="(project, projectIndex) in projects">
                          <div class="col">
                            <div class="card shadow-sm" style="height: 100%;">
                              
                              <div class="py-2 px-3">
                                <button class="btn border-0 w-100 text-start px-0" data-bs-toggle="collapse" :data-bs-target="`#projectCollapse${projectIndex}`">
                                    <span x-text="`${project.name} (#${project.id})`"></span>
                                    <span x-html="statusBadgeFormatter(project.STATUS)"></span>
                                </button>
                              </div>
                              
                              <div :id="`projectCollapse${projectIndex}`" class="collapse" data-bs-parent="#projectAccordion">
                                <div class="card-body pt-0 ">

                                  <h5 class="text-primary small">Milestones</h5>
                                  <hr class="mt-0 mb-2">
                                  <template x-if="project?.milestones.length">
                                    <div class="list-group gap-1">
                                      <template x-for="milestone in project.milestones">
                                        <button class="list-group-item list-group-item-action small border rounded-2 p-0 overflow-hidden"
                                                data-bs-toggle="offcanvas"
                                                data-bs-target="#taskListOffcanvas"
                                                @click="openMilestone = milestone;"
                                                >
                                                <span class="btn btn-light rounded-0 border-0 small me-1">
                                                  <i class="bi bi-flag"></i>
                                                </span>
                                                <span x-text="milestone.name_en"></span>
                                              </button>

                                      </template>
                                    </div>
                                  </template>
                                </div>
                              </div>
                            </div>
                          </div>
                        </template>
                    </div>
                  </div>
  
                  <!-- Complete Content -->
                  <div class="tab-pane fade" id="complete" role="tabpanel" x-data="{filterMode: 'today', nameMap: {
                    'today': 'Today',
                    'thisWeek': 'This Week',
                    'thisMonth': 'This Month',
                    'all': 'All'
                    }}">
                    <div class="btn-group btn-group-sm gap-2 w-100 mb-2" role="group">
                      <input type="radio" class="btn-check" name="btnradio" id="btnradio1" checked @click="filterMode='today'">
                      <label class="btn btn-outline-primary rounded-pill small" for="btnradio1">Today</label>
                    
                      <input type="radio" class="btn-check" name="btnradio" id="btnradio2">
                      <label class="btn btn-outline-primary rounded-pill small" for="btnradio2" @click="filterMode='thisWeek'">This Week</label>
                    
                      <input type="radio" class="btn-check" name="btnradio" id="btnradio3">
                      <label class="btn btn-outline-primary rounded-pill small" for="btnradio3" @click="filterMode='thisMonth'">This Month</label>

                      <input type="radio" class="btn-check" name="btnradio" id="btnradio4">
                      <label class="btn btn-outline-primary rounded-pill small" for="btnradio4" @click="filterMode='all'">All</label>
                    </div>
                    

                    <h6 class="text-muted text-secondary" x-text="nameMap[filterMode]"></h6>
                    <div id="tasksAccordion" class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-2 align-items-start">
                        <template x-for="(task, taskIndex) in filterTasks(tasks, filterMode)" :key="task.id">
                          <div class="col">
                            <div class="card shadow-sm" style="height: 100%;">
                              
                              <div class="py-2 px-3 d-flex align-items-center gap-3">
                                <button class="btn border-0 w-100 text-start px-0" data-bs-toggle="collapse" :data-bs-target="`#taskCollapse${taskIndex}`">
                                    <span x-text="`${task.name} (#${task.id})`"></span>
                                    <span x-html="statusBadgeFormatter(task.STATUS)"></span>
                                </button>
                                <a class="link-primary link-underline-opacity-0 small" :href="`/checklists/tasks/${task.id}/`">View</a>
                              </div>
                              
                              <div :id="`taskCollapse${taskIndex}`" class="collapse" data-bs-parent="#tasksAccordion">
                                <div class="card-body pt-0 ">
                                  <h6 class="text-primary small">Completed On: <span class="text-black fw-light" x-text="utc2Georgia(task.COMPLETED_AT)"></span></h6>

                                  <h6 class="text-primary small">Task Items: </h6>
                                  <hr class="mt-0 mb-2">
                                  <template x-if="task.task_checklist[0]?.task_items?.length">
                                    <ul class="list-group gap-1">
                                      <template x-for="taskItem in task.task_checklist[0].task_items">
                                        <li class="list-group-item list-group-item-action small border rounded-2"
                                                style="border-left-color: var(--bs-primary) !important; border-left-width: 6px !important;"
                                                >
                                                <i class="bi bi-flag me-1"></i>
                                                <span x-text="taskItem.title_en"></span>
                                              </li>

                                      </template>
                                    </ul>
                                  </template>
                                  <template x-if="!task.task_checklist[0]?.task_items?.length">
                                    <div class="border text-center text-bg-secondary rounded-2 p-2">
                                      No Items
                                    </div> 
                                  </template>
                                </div>
                              </div>
                            </div>
                          </div>
                        </template>
                    </div>
                  </div>
  
        </div>
      </div>
    </main>
  </template>


  <!-- region [modal] -->
  <div class="offcanvas offcanvas-bottom" style="height: 50vh; max-height: 100vh;" tabindex="-1" id="taskListOffcanvas">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title" id="offcanvasLabel">Tasks</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body overflow-y-auto pt-0">
      <template x-if="openMilestone?.tasks?.length">
        <div class="list-group gap-1">
          <template x-for="task in openMilestone.tasks">
            <a class="list-group-item list-group-item-action small border rounded-2 p-0 overflow-hidden"
                :href="`/checklists/tasks/${task.id}/`"
                >
                  <span class="btn btn-light rounded-0 border-0 small me-1">
                    <i class="bi bi-highlighter me-1"></i>
                  </span>
                  <span x-text="task.name"></span>
                </a>
                

          </template>
        </div>
      </template>
    </div>
  </div>
  <!-- endregion -->


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script src="/js/web-scripts.js"></script>
  <script src="/js/alpine/worker-dashboard.alpine.js"></script>
</body>
</html>