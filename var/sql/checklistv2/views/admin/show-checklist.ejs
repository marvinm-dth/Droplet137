<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Project Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/web-style.css">
</head>
<body>
  <!-- Sidebar --> <%- include('./_partials/sidebar.ejs') %> <!-- Main Content -->
  <div class="content">
    <div class="container-fluid mt-5">
      <a href="/checklists/admin/" class="fw-semibold link-dark text-decoration-none d-block mb-3"><i class="bi bi-arrow-left"></i> Back to
        Checklist</a>
      <h2 class="section-title"> Checklist Template Manager</h2>
      <div class="card shadow-sm border-0">
        <div class="card-header bg-primary-subtle">
          <h5 class="mb-0">Checklist Details</h5>
        </div>
        <div class="card-body">
          <form method="POST">
            <div class="row g-0">
              <h6 class="col col-form-label card-title">Type: </h6>
              <div class="col">
                <select class="form-select" name="type">
                  <option value="work" <%= (selectedChecklist.type == "work")? "selected":"" %>>Work</option>
                  <option value="inspection" <%= (selectedChecklist.type == "inspection")? "selected":"" %>>Inspection</option>
                </select>
              </div>
            </div>
            <h6 class="card-title mt-3">Title: </h6>
            <div class="input-group">
              <div class="form-floating">
                <textarea name="name_en" class="form-control form-control-sm h-100" placeholder=""><%= selectedChecklist.name_en %></textarea>
                <label class="text-muted">English</label>
              </div>
              <div class="form-floating">
                <textarea name="name_zh" class="form-control form-control-sm h-100" placeholder=""><%= selectedChecklist.name_zh %></textarea>
                <label class="text-muted">Chinese</label>
              </div>
            </div>
            <h6 class="card-title mt-3">Description: </h6>
            <div class="input-group">
              <div class="form-floating">
                <textarea name="description_en" class="form-control form-control-sm h-100"
                  placeholder=""><%= selectedChecklist.description_en %></textarea>
                <label class="text-muted">English</label>
              </div>
              <div class="form-floating">
                <textarea name="description_zh" class="form-control form-control-sm h-100"
                  placeholder=""><%= selectedChecklist.description_zh %></textarea>
                <label class="text-muted">Chinese</label>
              </div>
            </div>
            <div class="d-flex align-items-center justify-content-between mt-3">
              <button formaction="/checklists/delete/" type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash3-fill"></i></button>
              <button formaction="/checklists/patch/" type="submit" class="btn btn-sm btn-info">Save Changes</button>
              <input type="hidden" name="checklistId" value="<%=selectedChecklist.id%>"> <!-- ID for updating -->
              <input type="hidden" name="reloadUrl" value="/checklists/admin/"> <!-- ID for updating -->
            </div>
          </form>
        </div>
      </div>
      <h2 class="section-title"></h2>
      <div class="card shadow-sm border-0">
        <div class="card-header bg-primary-subtle">
          <h5 class="mb-0">Included Items</h5>
        </div>
        <div class="card-body">
          <div class="listjs">
            <form class="d-flex justify-content-end mb-3 gap-2" action="/checklists/items/" method="POST" onkeydown="return event.key !== 'Enter';">
              <input type="hidden" name="checklistId" value="<%= selectedChecklist.id %>">
              <input type="hidden" name="reloadUrl" value="/checklists/<%= selectedChecklist.id %>/">
              <div class="input-group w-50">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="itemTitle" class="fuzzy-search form-control w-50" placeholder="Search or add" required>
                <button type="submit" class="btn btn-outline-info btn-sm">Add Item</button>
              </div>
            </form>
            <div class="list list-group">
              <!-- ITEM LIST-GROUP TOGGLE FOR COLLAPSE -->
              <% if(selectedChecklist.items.length) { selectedChecklist.items.sort((a, b) => a.id - b.id).forEach((item, index) => { %> <div
                class="list-group-item px-2 py-1">
                <button class="btn w-100 d-flex align-items-center gap-2 border-0" type="button" data-bs-toggle="collapse"
                  data-bs-target="#itemCollapse<%=index%>">
                  <span class="d-inline-block me-auto text-truncate"><%= item.title_en %></span>
                  <span class="badge badge-sm bg-<%= item.require_photos?`primary`:`secondary`%> fs-6 p-2" title="Photo Required"><i
                      class="bi bi-camera"></i></span>
                  <span class="badge badge-sm bg-<%= item.require_videos?`danger`:`secondary`%> fs-6 p-2" title="Videos Required"><i
                      class="bi bi-camera-video"></i></span>
                  <span class="badge badge-sm bg-<%= item.require_comments?`success`:`secondary`%> fs-6 p-2" title="Comments Required"><i
                      class="bi bi-chat-left-text"></i></span>
                </button>
              </div>
              <!-- ITEM LIST-GROUP COLLAPSABLE CONTENT -->
              <div id="itemCollapse<%=index%>" class="collapse">
                <div class="p-3 bg-body-secondary">
                  <!-- NAV-TABS FOR CHECKLIST ITEM CONTENT -->
                  <form method="POST" onkeydown="return event.key !== 'Enter';">
                    <nav>
                      <div class="nav nav-tabs" id="nav-tab" role="tablist" style="font-size: .7rem;">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#navItemDetails<%=index%>" type="button" role="tab">Item
                          Details</button>
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#navMediaRef<%=index%>" type="button" role="tab">Media
                          Reference</button>
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#navRequire<%=index%>" type="button" role="tab">Submission
                          Requirements</button>
                      </div>
                    </nav>
                    <!-- NAV-TABS-CONTENT FOR CHECKLIST ITEM CONTENT -->
                    <div class="bg-white border border-top-0 p-3">
                      <div class="tab-content" id="navtabContent">
                        <div class="tab-pane fade p-0 show active" id="navItemDetails<%=index%>" role="tabpanel" tabindex="0">
                          <h6 class="text-muted card-title small">Title: </h6>
                          <div class="input-group">
                            <div class="form-floating">
                              <textarea name="title_en" class="form-control form-control-sm h-100" placeholder=""><%=item.title_en%></textarea>
                              <label class="text-muted">English</label>
                            </div>
                            <div class="form-floating">
                              <textarea name="title_zh" class="form-control form-control-sm h-100" placeholder=""><%=item.title_zh%></textarea>
                              <label class="text-muted">Chinese</label>
                            </div>
                          </div>
                          <h6 class="text-muted card-title mt-3 small">Description: </h6>
                          <div class="input-group">
                            <div class="form-floating">
                              <textarea name="description_en" class="form-control form-control-sm h-100"
                                placeholder=""><%=item.description_en%></textarea>
                              <label class="text-muted">English</label>
                            </div>
                            <div class="form-floating">
                              <textarea name="description_zh" class="form-control form-control-sm h-100"
                                placeholder=""><%=item.description_zh%></textarea>
                              <label class="text-muted">Chinese</label>
                            </div>
                          </div>
                          <h6 class="text-muted card-title mt-3 small">Note: </h6>
                          <div class="input-group">
                            <div class="form-floating">
                              <textarea name="notes_en" class="form-control form-control-sm h-100" placeholder=""><%=item.notes_en%></textarea>
                              <label class="text-muted">English</label>
                            </div>
                            <div class="form-floating">
                              <textarea name="notes_zh" class="form-control form-control-sm h-100" placeholder=""><%=item.notes_zh%></textarea>
                              <label class="text-muted">Chinese</label>
                            </div>
                          </div>
                        </div>
                        <div class="tab-pane fade p-0" id="navMediaRef<%=index%>" role="tabpanel" tabindex="0">
                          <div class="row gap-0">
                            <h6 class="col-4 col-form-label text-muted card-title" style="font-size: .875em !important;">Video Reference Link: </h6>
                            <div class="col">
                              <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-camera-video"></i></span>
                                <input name="video_link" class="form-control" type="text" placeholder="https://www.youtube.com/watch?v=dQw4w9WgXcQ"
                                  value="<%= item.video_link%>">
                              </div>
                            </div>
                          </div>
                          <h6 class="text-muted card-title mt-3 small">Video Description: </h6>
                          <div class="input-group">
                            <div class="form-floating">
                              <textarea name="video_desc_en" class="form-control form-control-sm h-100"
                                placeholder=""><%= item.video_desc_en%></textarea>
                              <label class="text-muted">English</label>
                            </div>
                            <div class="form-floating">
                              <textarea name="video_desc_zh" class="form-control form-control-sm h-100"
                                placeholder=""><%= item.video_desc_zh%></textarea>
                              <label class="text-muted">Chinese</label>
                            </div>
                          </div>
                          <h6 class="text-muted card-title mt-3 small">Photo References: </h6>
                          <p class="small fst-italic">Uploaded picture(s) will serve as a reference for the expected outcome of the item.</p>
                          <input class="form-control" type="file">
                        </div>
                        <div class="tab-pane fade p-0" id="navRequire<%=index%>" role="tabpanel" tabindex="0">
                          <div class="row g-0">
                            <div class="form-check row mb-2 col-6">
                              <div class="col-2">
                                <input name="require_photos" class="form-check-input" type="checkbox" id="requirePhotos<%=index%>"
                                  <%= item.require_photos?`checked`:``%>>
                              </div>
                              <div class="col-auto">
                                <label class="form-check-label" for="requirePhotos<%=index%>">Photo Proof </label>
                                <p class="small fst-italic">The staff must upload one or more photos before submitting the item for review.</p>
                              </div>
                            </div>
                            <div class="form-check row col-6">
                              <div class="col-2">
                                <input name="require_comments" class="form-check-input" type="checkbox" id="requireComments<%=index%>"
                                  <%= item.require_videos?`checked`:``%>>
                              </div>
                              <div class="col-auto">
                                <label class="form-check-label" for="requireComments<%=index%>">Staff Comment </label>
                                <p class="small fst-italic">The staff must include specific text required for the task before submitting the item for
                                  review.</p>
                              </div>
                            </div>
                          </div>
                          <div class="row g-0">
                            <div class="form-check row mb-2 col-6">
                              <div class="col-2">
                                <input name="require_videos" class="form-check-input" type="checkbox" id="requireVideo<%=index%>"
                                  <%= item.require_comments?`checked`:``%>>
                              </div>
                              <div class="col-auto">
                                <label class="form-check-label" for="requireVideo<%=index%>">Video Proof </label>
                                <p class="small fst-italic">Staff must record a video of the completed task before submitting it for review.</p>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="d-flex justify-content-between mt-3">
                        <input type="hidden" name="reloadUrl" value="/checklists/<%=selectedChecklist.id%>/">
                        <input type="hidden" name="itemId" value="<%=item.id%>">
                        <button formaction="/checklists/items/delete/" type="submit" class="btn btn-sm btn-danger"><i
                            class="bi bi-trash3-fill"></i></button>
                        <button formaction="/checklists/items/patch/" type="submit" class="btn btn-sm btn-info">Save Changes</button>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
              <!-- END ITEM COLLAPSABLE CONTENT --> <% })} else  {%> <div class="text-center">
                <span class="text-muted"> <i class="bi bi-clipboard-x text-secondary"></i> No item yet. Start by adding one!</span>
              </div> <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/list.js@2.3.1/dist/list.min.js"></script>
  <script src="/js/web-scripts.js"></script>
</body>
</html>