<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <title>Data Dashboard</title>
</head>
<body x-data="databoard" x-init="start()" class="p-3">
  <template x-if="appLoading">
    <div style="z-index: 2000;"
      class="position-fixed top-0 start-0 d-flex align-items-center justify-content-center vh-100 vw-100 bg-light opacity-75">
      <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
    </div>
  </template>
  <template x-if="!initialFetching">
    <template x-for="(workshop, workshopIndex) in workshops">
      <div class="card mb-2">
        <button class="btn w-100 text-start py-3 px-0 border-0 collapsed"
                type="button"
                data-bs-toggle="collapse"
                :data-bs-target="`#workshopCollapse${workshopIndex}`"
                x-text="`Milestone: ${workshop.name} (#${workshop.id})`"
                ></button>
        <div :id="`workshopCollapse${workshopIndex}`" class="collase">
          asdasd
        </div>
      </div>


    </template>
    
  </template>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/notyf/3.10.0/notyf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script src="/js/web-scripts.js"></script>
  <script>
    document.addEventListener('alpine:init', () => {


      Alpine.data('databoard', () => ({
        appLoading: false,
        initialFetching: false,
        authUser: null,

        workshops: {},

        async start() {
          this.appLoading = true;
          this.initialFetching = true,

          this.authUser = await getData(`/checklists/api/myself/`);
          this.workshops = await getData(`/checklists/api/developer/data/`);

          this.initialFetching = false,
          this.appLoading = false;
        }
      }))
    });
  </script>
</body>
</html>