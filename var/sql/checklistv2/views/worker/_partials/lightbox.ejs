<style>
  .lightbox {
      display: flex;
      opacity: 0;
      visibility: hidden;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgb(0, 0, 0);
      justify-content: center;
      align-items: center;
      z-index: 2000; /* Above Bootstrap modal */
      transition: opacity 0.250s ease-in-out, visibility 0.250s ease-in-out;
      overflow: auto;
  }

  .lightbox.show {
      opacity: 1;
      visibility: visible;
  }
  
  .lightbox img {
    transition: transform 0.3s ease-in-out; /* Smooth transition for scale and rotate */
}

/* Portrait Mode */
@media screen and (orientation: portrait) {
    .lightbox img {
        width: 100vw;
        height: auto;
    }
    .lightbox img.rotated {
        width: auto;
        height: 100vw;
        max-height: 100%;
    }
}

/* Landscape Mode */
@media screen and (orientation: landscape) {
    .lightbox img {
        width: auto;
        height: 100vh;
    }
    .lightbox img.rotated {
        width: 100vh;
        height: auto;
    }
}


  .lightbox #lightbox-toolbox {
      position: fixed;
      bottom: 0;
      left: 0;
      z-index: 20000;
      display: flex;
      padding: 10px;
      width: 100%;
      background: rgb(0, 0, 0, .8);

  }

  .lightbox #lightbox-toolbox button {
      font-size: 30px;
      color: white;
      background: none;
      border: none;
      padding: 10px;
      flex-grow: 1;
  }
</style>

<div id="lightboxModal" class="lightbox" :class="isLightBoxOpen ? 'show':''" 
     x-data="{ portrait: true, rotation: 0, scaling: 1 }">
  
  <div id="lightbox-toolbox">
    <button @click.stop="rotation += 90; portrait = !portrait">&#8635;</button>
    <button @click.stop="scaling = Math.min(scaling + 0.5, 6)">&#43;</button>
    <button @click.stop="scaling = Math.max(scaling - 0.5, 1)">&#8722;</button>
    <button @click.stop="
      isLightBoxOpen = false;
      lightboxImage = '';
      rotation = 0;
      scaling = 1;
      portrait = true;
    ">&times;</button>
  </div>
  
    <img
      :src="lightboxImage"
      :class="rotation % 180 ? 'rotated' : ''"
      :style="'transform: scale(' + scaling + ') rotate(' + rotation + 'deg)'"
    >
</div>
