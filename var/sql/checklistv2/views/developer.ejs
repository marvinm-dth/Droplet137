<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <title><%= locals.pageTitle || 'My App' %></title>

</head>
<body>

    <div id="app" class="container-md">
        <div class="row gx-4 mt-3">
            <div class="col-4">
                <div class="p-3 rounded shadow bg-secondary-subtle" style="min-height: 200px; height: 100%;">
                    <form action="/developer/workshop/" method="GET">
                        <h5>Add Workshop</h5>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" name="name">
                        </div>

                        <button class="btn btn-primary d-block ms-auto">Add</button>
                    </form>
                </div>
            </div>
            <div class="col-4">
                <div class="p-3 rounded shadow bg-secondary-subtle" style="min-height: 200px; height: 100%;">
                    <form action="/developer/project/" method="GET">
                        <h5>Add Project</h5>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" name="name">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Workshop parent</label>
                            <select type="text" class="form-select" name="workshopId">
                                <option value="">1</option>
                                <option value="">2</option>
                                <option value="">3</option>
                            </select>
                        </div>

                        <button class="btn btn-primary d-block ms-auto">Add</button>
                    </form>
                </div>
            </div>
            <div class="col-4">
                <div class="p-3 rounded shadow bg-secondary-subtle" style="min-height: 200px; height: 100%;">
                    <form action="/developer/workshop" method="GET">
                        <h5>Add Milestone</h5>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" name="name">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Project parent</label>
                            <select type="text" class="form-select" name="projectId">
                                <option value="">1</option>
                                <option value="">2</option>
                                <option value="">3</option>
                            </select>
                        </div>

                        <button class="btn btn-primary d-block ms-auto">Add</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="row gx-4 mt-3">
            <div class="col-4">
                <div class="p-3 rounded shadow bg-secondary-subtle" style="min-height: 200px; height: 100%;">
                    <form action="/developer/workshop/" method="GET">
                        <h5>Add Task</h5>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" name="name">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Milestone parent</label>
                            <select type="text" class="form-select" name="milestoneId">
                                <option value="">1</option>
                                <option value="">2</option>
                                <option value="">3</option>
                            </select>
                        </div>

                        <button class="btn btn-primary d-block ms-auto">Add</button>
                    </form>
                </div>
            </div>
            <div class="col-4">
                <div class="p-3 rounded shadow bg-secondary-subtle" style="min-height: 200px; height: 100%;">
                    <form action="/developer/project/" method="GET">
                        <h5>Add Subtask</h5>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" name="name">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Task parent</label>
                            <select type="text" class="form-select" name="taskId">
                                <option value="">1</option>
                                <option value="">2</option>
                                <option value="">3</option>
                            </select>
                        </div>

                        <button class="btn btn-primary d-block ms-auto">Add</button>
                    </form>
                </div>
            </div>
            <div class="col-4">
                <div class="p-3 rounded shadow bg-secondary-subtle" style="min-height: 200px; height: 100%;">
                    <form action="/developer/workshop" method="GET">
                        <h5>Add Microtask</h5>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" name="name">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Subtask parent</label>
                            <select type="text" class="form-select" name="subtaskId">
                                <option value="">1</option>
                                <option value="">2</option>
                                <option value="">3</option>
                            </select>
                        </div>

                        <button class="btn btn-primary d-block ms-auto">Add</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="row gx-4 mt-3">
            <div class="col-4">
                <div class="p-3 rounded shadow bg-secondary-subtle" style="min-height: 200px; height: 100%;">
                    <form action="/developer/workshop/" method="GET">
                        <h5>Add Task Checklist</h5>

                        <div class="mb-3">
                            <label class="form-label">Task parent</label>
                            <select type="text" class="form-select" name="taskId">
                                <option value="">1</option>
                                <option value="">2</option>
                                <option value="">3</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Checklist template</label>
                            <select type="text" class="form-select" name="checklistId">
                                <option value="">1</option>
                                <option value="">2</option>
                                <option value="">3</option>
                            </select>
                        </div>

                        <button class="btn btn-primary d-block ms-auto">Add</button>
                    </form>
                </div>
            </div>
            <div class="col-4">
                <div class="p-3 rounded shadow bg-secondary-subtle" style="min-height: 200px; height: 100%;">
                    <form action="/developer/workshop" method="GET">
                        <h5>Add User Item</h5>

                        <div class="mb-3">
                            <label class="form-label">User</label>
                            <select type="text" class="form-select" name="userId">
                                <option value="">1</option>
                                <option value="">2</option>
                                <option value="">3</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Checklist item</label>
                            <select type="text" class="form-select" name="taskItemId">
                                <option value="">1</option>
                                <option value="">2</option>
                                <option value="">3</option>
                            </select>
                        </div>

                        <button class="btn btn-primary d-block ms-auto">Add</button>
                    </form>
                </div>
            </div>
            <div class="col-4">
                <div class="p-3 rounded shadow bg-secondary-subtle" style="min-height: 200px; height: 100%;">
                    <form action="/developer/project/" method="GET">
                        <h5>Add User</h5>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" name="name">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Role</label>
                            <select type="text" class="form-select" name="role">
                                <option value="staff">staff</option>
                                <option value="manager">manager</option>
                            </select>
                        </div>

                        <button class="btn btn-primary d-block ms-auto">Add</button>
                    </form>
                </div>
            </div>
            
        </div>
    </div>

</body>
</html>